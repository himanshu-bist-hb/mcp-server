# Required by every server except weather-forecast (Open-Meteo needs no key)
SERPAPI_API_KEY=your_serpapi_key
# Optional: if set, every endpoint requires an Authorization: Bearer <token> header
MCP_AUTH_TOKEN=

# Pine Labs payments (pinelabs-payments server): from the Pine Labs merchant dashboard
PINELABS_CLIENT_ID=your_client_id
PINELABS_CLIENT_SECRET=your_client_secret
# uat (default) or prod. prod requires MCP_AUTH_TOKEN to be set.
PINELABS_ENV=uat
# Safety cap per payment link, in INR (default 500000)
MAX_LINK_AMOUNT_INR=500000
